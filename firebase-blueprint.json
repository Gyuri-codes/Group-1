{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firestore-blueprint.json",
  "entities": {
    "User": {
      "collection": "users",
      "fields": {
        "id": { "type": "string", "description": "Unique user ID matching Auth UID" },
        "name": { "type": "string", "description": "Full name" },
        "firstName": { "type": "string", "description": "First name" },
        "lastName": { "type": "string", "description": "Last name" },
        "email": { "type": "string", "description": "User email address" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "role": { "type": "string", "description": "User role: customer, staff, or admin" },
        "loyaltyPoints": { "type": "number", "description": "Accumulated Glow Club loyalty points" },
        "loyaltyTier": { "type": "string", "description": "Tier name: Sand, Wave, Sunbeam, Golden Glow" },
        "savedDestinations": { "type": "array", "description": "IDs of saved attractions" },
        "bookingHistory": { "type": "array", "description": "List of reservation reference numbers" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" }
      }
    },
    "Reservation": {
      "collection": "reservations",
      "fields": {
        "id": { "type": "string", "description": "Unique reservation ID" },
        "referenceNumber": { "type": "string", "description": "Booking confirmation code" },
        "roomId": { "type": "string", "description": "Room identifier" },
        "roomName": { "type": "string", "description": "Name of booked room or villa" },
        "guestName": { "type": "string", "description": "Primary guest full name" },
        "firstName": { "type": "string", "description": "Guest first name" },
        "lastName": { "type": "string", "description": "Guest last name" },
        "email": { "type": "string", "description": "Contact email" },
        "phone": { "type": "string", "description": "Contact mobile number" },
        "checkInDate": { "type": "string", "description": "Check-in date YYYY-MM-DD" },
        "checkOutDate": { "type": "string", "description": "Check-out date YYYY-MM-DD" },
        "nights": { "type": "number", "description": "Total length of stay in nights" },
        "adults": { "type": "number", "description": "Number of adults" },
        "children": { "type": "number", "description": "Number of children" },
        "roomCount": { "type": "number", "description": "Number of rooms booked" },
        "totalAmountPHP": { "type": "number", "description": "Total booking amount in PHP" },
        "depositPaidPHP": { "type": "number", "description": "Deposit amount paid in PHP" },
        "balanceDuePHP": { "type": "number", "description": "Remaining balance in PHP" },
        "paymentMethod": { "type": "string", "description": "Chosen payment method" },
        "paymentStatus": { "type": "string", "description": "Deposit or payment status" },
        "bookingStatus": { "type": "string", "description": "Confirmed, Checked-In, Completed, Cancelled" },
        "guestId": { "type": "string", "description": "UID of guest if authenticated" },
        "createdAt": { "type": "string", "description": "Timestamp when booking was created" }
      }
    },
    "Review": {
      "collection": "reviews",
      "fields": {
        "id": { "type": "string", "description": "Review ID" },
        "author": { "type": "string", "description": "Guest name" },
        "rating": { "type": "number", "description": "Rating out of 5" },
        "comment": { "type": "string", "description": "Review text" },
        "date": { "type": "string", "description": "Date formatted" },
        "roomStayed": { "type": "string", "description": "Room type stayed" },
        "title": { "type": "string", "description": "Review title" },
        "likes": { "type": "number", "description": "Count of likes" }
      }
    }
  }
}
